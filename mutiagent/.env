# ---------- Python 解释器（虚拟环境）----------
# 统一用项目内的 .venv，不要用系统里那个假的 WindowsApps\python.exe
# 运行命令：  .\.venv\Scripts\python.exe selfcheck.py


# ---------- 大模型厂商 ----------
# 可选：deepseek | openai | anthropic | qwen | zhipu | moonshot | openrouter | ollama | custom
LLM_PROVIDER=deepseek
# 留空则用该厂商预设模型；deepseek 官方模型名：deepseek-chat / deepseek-reasoner
LLM_MODEL=deepseek-chat
# 留空则用该厂商预设地址
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-bcc13a33b3604a0cbaf4c320428f593f

# ---------- 模型调用参数 ----------
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_STREAMING=true

# ---------- LangGraph 运行参数 ----------
GRAPH_RECURSION_LIMIT=50
GRAPH_THREAD_ID=default-thread
GRAPH_CHECKPOINTER=memory
GRAPH_STORE=memory
GRAPH_MAX_CONCURRENCY=4

# ---------- 多智能体编排 ----------
AGENT_MAX_ROUNDS=10


